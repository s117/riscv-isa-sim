spike_main_subproject_deps = \
	softfloat \
	riscv \

spike_main_install_prog_srcs = \
	spike.cc \
	spike-dasm.cc \
	xspike.cc \
	termios-xspike.cc \

spike_main_hdrs = \

spike_main_srcs = \
  extensions.cc \
  spike_build_info.cc \

# Build information (git version, compiler, date...) of spike, printed by spike --version. Regenerated by every build;
# the file is rewritten only when its content changed.
.PHONY : stamp-spike-build-info
stamp-spike-build-info :

spike_build_info.cc : stamp-spike-build-info
	$(scripts_dir)/stamp-build-info.sh $@ spike "spike" $(src_dir) "$(CXX)" "$(CXXFLAGS)" "@host@"

spike_main_junk += spike_build_info.cc
